---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import { demoUrl, waitlistHref } from '../lib/contacto';
---

<Base
  title="RaketSense — Inteligencia de negocio para clubes de tenis y pádel"
  description="RaketSense: inteligencia de negocio para clubes de tenis y pádel. Toda la gestión del club en un solo lugar —reservas, caja, socios, profesores, academia y torneos— y un panel que te dice cómo va el club."
  ogDescription="Gestión integral e inteligencia de negocio para quien administra el club. Cada mañana, una lectura de cómo viene el mes y qué hay que resolver."
>
  <style>
    /* Panel de ejemplo, montado sobre el borde de la portada. */
    .panel-sobre { margin-top: -7.5rem; position: relative; z-index: 2; padding-bottom: 1rem; }
    .verdict {
      border: 1px solid var(--border); border-radius: 9px; background: var(--surface); overflow: hidden;
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.28);
    }
    .verdict-bar {
      display: flex; align-items: center; justify-content: space-between; gap: 1rem;
      padding: 0.6rem 1rem; border-bottom: 1px solid var(--hair);
      font-size: 0.78rem; color: var(--muted);
    }
    .verdict-bar b { color: var(--ink2); font-weight: 600; }
    .verdict-body { padding: 1.25rem 1rem 1rem; }
    .verdict-body .eyebrow { margin-bottom: 0.4rem; }
    .verdict-body h3 { font-size: clamp(1.15rem, 2.4vw, 1.5rem); letter-spacing: -0.02em; line-height: 1.2; }
    .verdict-body p { color: var(--ink2); margin-top: 0.35rem; font-size: 0.95rem; }
    .kpis { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--hair); }
    .kpi { padding: 0.9rem 1rem; border-right: 1px solid var(--hair); }
    .kpi:last-child { border-right: 0; }
    .kpi .k { font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
    .kpi .v { font-size: 1.35rem; font-weight: 700; letter-spacing: -0.02em; margin-top: 0.15rem; }
    .kpi .d { font-size: 0.75rem; color: var(--muted); }
    .kpi .neg { color: var(--accent-ink); }
    .todo { border-top: 1px solid var(--hair); }
    .todo-row { display: flex; justify-content: space-between; gap: 1rem; padding: 0.7rem 1rem; border-bottom: 1px solid var(--hair); font-size: 0.9rem; }
    .todo-row:last-child { border-bottom: 0; }
    .todo-row small { display: block; color: var(--muted); font-size: 0.8rem; }
    .todo-row .act { color: var(--accent-ink); font-weight: 600; white-space: nowrap; }
    @media (max-width: 640px) {
      .kpis { grid-template-columns: repeat(2, 1fr); }
      .kpi:nth-child(2) { border-right: 0; }
      .kpi:nth-child(-n + 2) { border-bottom: 1px solid var(--hair); }
    }

    /* El club entero: tres tarjetas con foto. */
    .vida { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 2rem; }
    .vida-card { border: 1px solid var(--border); border-radius: 9px; overflow: hidden; background: var(--surface); transition: transform 250ms ease, border-color 250ms ease; }
    .vida-card:hover { transform: translateY(-4px); border-color: var(--accent); }
    .vida-captura { aspect-ratio: 16 / 10; overflow: hidden; background: #0a0a0a; border-bottom: 1px solid var(--hair); }
    .vida-captura :global(.foto) { transition: transform 900ms ease; }
    .vida-card:hover .vida-captura :global(.foto) { transform: scale(1.05); }
    .vida-texto { padding: 1rem 1.1rem 1.15rem; }
    .vida-texto b { display: block; font-size: 1.15rem; letter-spacing: -0.02em; }
    .vida-texto span { font-size: 0.9rem; color: var(--ink2); }
    @media (max-width: 760px) { .vida { grid-template-columns: 1fr; } }

    .questions { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem 2rem; margin-top: 2rem; }
    @media (max-width: 900px) { .questions { grid-template-columns: repeat(2, 1fr); } }
    .q { border-left: 2px solid var(--accent); padding-left: 1rem; }
    .q b { display: block; font-size: 1.05rem; letter-spacing: -0.01em; }
    .q span { color: var(--ink2); font-size: 0.92rem; }
    @media (max-width: 640px) { .questions { grid-template-columns: 1fr; } }

    /* Demo: banda oscura con la demo en un marco de navegador. */
    .demo { border-top: 0 !important; }
    .demo-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 3rem; align-items: center; }
    .demo .lead { margin: 0.5rem 0 1.5rem; }
    .demo-pasos { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1.75rem; }
    .demo-pasos span { font-size: 0.8rem; padding: 0.25rem 0.6rem; border: 1px solid var(--border); border-radius: 999px; color: var(--ink2); }
    .marco { display: block; border: 1px solid var(--border); border-radius: 9px; overflow: hidden; background: #121211; box-shadow: 0 30px 70px rgba(0, 0, 0, 0.5); text-decoration: none; transition: transform 250ms ease; }
    .marco:hover { transform: translateY(-4px); }
    .marco-barra { display: flex; align-items: center; gap: 6px; padding: 0.55rem 0.8rem; border-bottom: 1px solid var(--hair); font-size: 0.72rem; color: var(--muted); }
    .marco-barra i { width: 9px; height: 9px; border-radius: 999px; background: rgba(255, 255, 255, 0.2); }
    .marco-barra span { margin-left: 0.6rem; }
    .marco-cuerpo { aspect-ratio: 1200 / 630; }
    @media (max-width: 860px) { .demo-grid { grid-template-columns: 1fr; gap: 2rem; } }

    /* Quiénes: foto + trayectoria, en una franja baja. */
    .quienes { display: grid; grid-template-columns: 1fr 1.1fr; gap: 2.5rem; align-items: center; }
    /* Las dos caras: el club y la IA, lado a lado. */
    .caras { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .cara { aspect-ratio: 4 / 5; border-radius: 9px; overflow: hidden; background: #0a0a0a; }
    .cara-club :global(.foto) { object-position: 20% center; }
    .cara-ia :global(.foto) { object-position: 12% 20%; }
    .quienes .lead { margin-top: 0.5rem; }
    .hitos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--hair); border: 1px solid var(--hair); border-radius: 7px; overflow: hidden; margin-top: 1.25rem; }
    .hito { background: var(--bg); padding: 0.85rem 1rem; }
    .hito b { display: block; font-size: 1.3rem; letter-spacing: -0.03em; }
    .hito span { font-size: 0.82rem; color: var(--ink2); }
    @media (max-width: 860px) { .quienes { grid-template-columns: 1fr; gap: 1.5rem; } }
    @media (max-width: 520px) { .hitos { grid-template-columns: 1fr; } }

    /* Precio + Clubes Semilla: dos tarjetas gemelas (misma estructura, mismo alto, botón al pie). */
    .price { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; align-items: stretch; margin-top: 2rem; }
    .price-card { display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: 9px; background: var(--surface); padding: 1.75rem; }
    .price-card.seed { border-color: var(--accent); background: var(--accent-soft); }
    .price-card h3 { font-size: 1.4rem; letter-spacing: -0.02em; line-height: 1.2; margin-bottom: 0.5rem; }
    .price-card p { color: var(--ink2); font-size: 0.95rem; min-height: 3em; }
    .price-card .lista { margin: 1.1rem 0 1.5rem; }
    .price-card .btn { margin-top: auto; align-self: flex-start; }
    @media (max-width: 760px) { .price { grid-template-columns: 1fr; } .price-card p { min-height: 0; } }
  </style>

  <!-- PORTADA -->
  <header class="hero sobre-oscuro">
    <div class="hero-media"><Foto nombre="portada" alt="Canchas de polvo de ladrillo vistas desde arriba" prioridad /></div>
    <div class="wrap">
      <a href="/club-semilla" class="pill"><b>Próximo lanzamiento</b> Programa Clubes Semilla abierto →</a>
      <p class="eyebrow">Tenis · Pádel · Gestión con inteligencia artificial</p>
      <h1>Inteligencia de negocio <span>para tu club.</span></h1>
      <p class="lead">
        RaketSense reúne toda la gestión del club —reservas, caja, socios, profesores,
        academia y torneos— y la convierte en inteligencia: cada mañana, una lectura
        clara de cómo viene el mes y qué hay que resolver.
      </p>
      <div class="hero-actions">
        <a href={demoUrl} class="btn btn-primary btn-lg">Probá la demo</a>
        <a href="/club-semilla" class="btn btn-lg">Quiero ser Club Semilla</a>
      </div>
      <p class="hero-note">Siete pasos en un club de ejemplo. Sin registrarte.</p>
    </div>
  </header>

  <!-- La pantalla que el dueño ve cada mañana, en texto real. -->
  <div class="wrap panel-sobre">
    <div class="verdict aparece" id="panel" aria-label="Ejemplo del panel">
      <div class="verdict-bar">
        <span><b>Panel</b> · Parque Tenis Club</span>
        <span>Septiembre · actualizado 08:10</span>
      </div>
      <div class="verdict-body">
        <p class="eyebrow">Cómo va el club</p>
        <h3>Septiembre viene 6% abajo, con la ocupación de los martes a la noche en 40%.</h3>
        <p>Hay $ 1.240.000 jugados y sin cobrar. La academia sostiene el mes.</p>
      </div>
      <div class="kpis">
        <div class="kpi"><div class="k">Ingresos</div><div class="v">$ 13,6 M</div><div class="d neg">−6% vs agosto</div></div>
        <div class="kpi"><div class="k">Por cobrar</div><div class="v">$ 1,24 M</div><div class="d">reservas jugadas</div></div>
        <div class="kpi"><div class="k">Ocupación</div><div class="v">36%</div><div class="d">sobre canchas activas</div></div>
        <div class="kpi"><div class="k">Resultado</div><div class="v">$ 4,1 M</div><div class="d">margen 30%</div></div>
      </div>
      <div class="todo">
        <div class="todo-row"><div>3 socios que dejaron de venir<small>Jugaban 2 veces por semana hasta julio.</small></div><span class="act">Ver quiénes →</span></div>
        <div class="todo-row"><div>1 cierre de caja con diferencia<small>Faltante de $ 12.500 el 14/09.</small></div><span class="act">Ver cierre →</span></div>
        <div class="todo-row"><div>2 grupos de academia con lugar<small>Sub-14 martes y jueves: quedan 4 cupos.</small></div><span class="act">Ver grupos →</span></div>
      </div>
    </div>
  </div>

  <!-- EL CLUB ENTERO: tres fotos (cuando esté el club demo, capturas del panel) -->
  <section class="primera">
    <div class="wrap">
      <p class="eyebrow aparece">Para clubes de raqueta</p>
      <h2 class="aparece">Un club es mucho más que una grilla de turnos.</h2>
      <p class="lead aparece">Canchas, gente, profesores, chicos que arrancan. RaketSense mira el club entero, no solo las reservas.</p>
      <div class="vida">
        <div class="vida-card aparece">
          <div class="vida-captura"><Foto nombre="tenis" alt="Saque en una cancha de polvo de ladrillo, visto desde arriba" /></div>
          <div class="vida-texto"><b>Tenis</b><span>Turnos fijos, socios de toda la vida y canchas que hay que cuidar.</span></div>
        </div>
        <div class="vida-card aparece t1">
          <div class="vida-captura"><Foto nombre="padel" alt="Paletas y pelotas sobre una cancha de pádel azul" variante="padel" /></div>
          <div class="vida-texto"><b>Pádel</b><span>Turnos de hora y media, noches llenas y mañanas por llenar.</span></div>
        </div>
        <div class="vida-card aparece t2">
          <div class="vida-captura"><Foto nombre="academia" alt="Una mano saca una pelota del canasto de la clase" /></div>
          <div class="vida-texto"><b>Academia</b><span>Grupos por edad y nivel, cuotas al día y profes con la agenda completa.</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- QUIÉNES -->
  <section id="quienes">
    <div class="wrap quienes">
      <div class="caras aparece">
        <figure class="cara cara-club">
          <Foto nombre="equipo" alt="En la cancha de polvo de ladrillo, con una clase de fondo" />
        </figure>
        <figure class="cara cara-ia">
          <Foto nombre="equipo-ia" alt="Dando una charla sobre agentes de inteligencia artificial" />
        </figure>
      </div>
      <div>
        <p class="eyebrow aparece">Quiénes lo hacemos</p>
        <h2 class="aparece">Hecho por gente de club.</h2>
        <p class="lead aparece">
          RaketSense nace adentro de un club. Lo dirige un profesor de educación física y
          licenciado en gestión que estuvo más de quince años al frente de una academia de
          tenis, y que hoy es ingeniero en inteligencia artificial. Las dos caras en la misma
          persona: por eso no arranca en la tecnología, arranca en el mostrador.
        </p>
        <div class="hitos aparece">
          <div class="hito"><b>+15 años</b><span>dirigiendo una academia de tenis</span></div>
          <div class="hito"><b>Gestión</b><span>licenciatura y oficio de club</span></div>
          <div class="hito"><b>IA</b><span>ingeniería aplicada a tus datos</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- DEMO -->
  <section class="demo sobre-oscuro" id="demo">
    <div class="wrap demo-grid">
      <div>
        <p class="eyebrow aparece">Demo</p>
        <h2 class="aparece">Probá un día en un club de pádel.</h2>
        <p class="lead aparece">
          Recorré Las Tipas Pádel, un club de ejemplo que usa RaketSense hace cuatro meses.
          Siete pasos, a tu ritmo, sin registrarte.
        </p>
        <div class="demo-pasos aparece">
          <span>Abrir la caja</span><span>Reservar una cancha</span><span>Cobrar</span><span>Encontrar las horas flojas</span><span>Cerrar la caja</span>
        </div>
        <a href={demoUrl} class="btn btn-primary btn-lg aparece">Probá la demo →</a>
      </div>
      <a href={demoUrl} class="marco aparece t1" aria-label="Abrir la demo de RaketSense">
        <div class="marco-barra"><i></i><i></i><i></i><span>{new URL(demoUrl).host}</span></div>
        <div class="marco-cuerpo"><Foto nombre="demo" alt="Grilla de reservas de la demo de RaketSense" variante="padel" /></div>
      </a>
    </div>
  </section>

  <!-- INTELIGENCIA: posicionamiento + las seis preguntas. Sin promesas de funciones de IA. -->
  <section id="inteligencia">
    <div class="wrap">
      <p class="eyebrow aparece">Inteligencia</p>
      <h2 class="aparece">Las apps de reservas te dicen quién jugó. RaketSense te dice cómo va el club.</h2>
      <p class="lead aparece">
        Seis preguntas que hoy contestás a ojo, respondidas con lo que el mostrador carga todos
        los días. Pensado desde el primer día para trabajar con inteligencia artificial sobre los
        datos reales de tu club.
      </p>
      <div class="questions">
        <div class="q aparece"><b>¿De dónde viene la plata?</b><span>Ingresos por fuente: alquiler, academia, buffet, torneos. Cuál crece y cuál se cae.</span></div>
        <div class="q aparece t1"><b>¿Cuándo tengo las canchas vacías?</b><span>Ocupación por día y hora. La franja muerta del martes, con nombre y apellido.</span></div>
        <div class="q aparece t2"><b>¿Gané o perdí este mes?</b><span>Ingresos contra egresos, con costos reales de profesores y buffet, no facturación bruta.</span></div>
        <div class="q aparece"><b>¿Quién dejó de venir?</b><span>Socios en riesgo antes de que se vayan del todo. Retención es plata.</span></div>
        <div class="q aparece t1"><b>¿Cómo crece la academia?</b><span>Alumnos, clases y grupos por profesor, mes a mes. Datos para que cada profe llene su agenda.</span></div>
        <div class="q aparece t2"><b>¿Cómo vienen los cobros?</b><span>Cuenta corriente por familia, saldos claros y cobro directo desde la caja.</span></div>
      </div>
    </div>
  </section>

  <!-- GESTIÓN INTEGRAL -->
  <section id="gestion">
    <div class="wrap">
      <p class="eyebrow aparece">Gestión integral</p>
      <h2 class="aparece">La captura del dato, sin cambiar cómo trabaja tu gente.</h2>
      <p class="lead aparece">El socio sigue reservando por WhatsApp o en el mostrador. El staff lo carga en segundos, y de ahí sale todo lo demás.</p>
      <div class="grid-3 aparece">
        <div class="cell"><span class="tag">Reservas</span><h3>Grilla por cancha y hora</h3><p>Eventuales, fijos semanales, clases y academia en la misma grilla. Sin doble reserva: lo garantiza la base, no la memoria del mostrador.</p></div>
        <div class="cell"><span class="tag">Caja</span><h3>Apertura, cobros, arqueo y cierre Z</h3><p>Efectivo, transferencia, tarjeta o cuenta corriente. Cada peso queda en un libro que no se edita: se revierte.</p></div>
        <div class="cell"><span class="tag">Socios</span><h3>Padrón, categorías y precios diferenciales</h3><p>Socio, abonado, cliente. Responsable de pago por familia, carnet al día, cuenta corriente.</p></div>
        <div class="cell"><span class="tag">Canchas</span><h3>Tarifas por franja y mantenimiento</h3><p>Precio por categoría y horario. Tareas de mantenimiento con costo, que entran al resultado del club.</p></div>
        <div class="cell"><span class="tag">Profesores y academia</span><h3>Clases, grupos y cuotas</h3><p>Disponibilidad, clases particulares, grupos por edad y nivel con cuota mensual. Lo que cobra el club y lo que le paga al profe.</p></div>
        <div class="cell"><span class="tag">Torneos</span><h3>Inscripción, cuadro y programación</h3><p>Eliminación o round robin. Cada partido programado ocupa la cancha de verdad, y la inscripción se cobra en caja.</p></div>
      </div>
    </div>
  </section>

  <!-- PRECIO -->
  <section id="precio">
    <div class="wrap">
      <p class="eyebrow aparece">Precio</p>
      <h2 class="aparece">Simple y predecible.</h2>
      <div class="price aparece">
        <div class="price-card">
          <h3>Suscripción mensual</h3>
          <p>Un abono mensual por club, a precio fijo. Sin sorpresas a fin de mes.</p>
          <ul class="lista">
            <li>Canchas, socios y usuarios sin límite</li>
            <li>Panel completo con las seis respuestas</li>
            <li>Reservas, caja, socios, profesores, academia y torneos</li>
            <li>Exportación para el contador</li>
            <li>Soporte directo por WhatsApp</li>
          </ul>
          <a href={waitlistHref} class="btn btn-primary">Unirme a la lista de espera</a>
        </div>
        <div class="price-card seed" id="semilla">
          <h3>Programa Clubes Semilla</h3>
          <p>Un grupo reducido de clubes que nos acompaña desde el principio. Cupos limitados, de 3 a 20 canchas.</p>
          <ul class="lista">
            <li>Precio diferencial para siempre</li>
            <li>Puesta en marcha en tu club, con nosotros al lado</li>
            <li>Línea directa con el equipo que lo construye</li>
            <li>Tu feedback define lo que se desarrolla después</li>
            <li>Nadie arranca solo: te acompañamos las primeras semanas</li>
          </ul>
          <a href="/club-semilla" class="btn btn-primary">Quiero ser Club Semilla</a>
        </div>
      </div>
    </div>
  </section>
</Base>
