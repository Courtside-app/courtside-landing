---
const adminAppUrl = 'https://courtside-admin.vercel.app';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Courtside — La plataforma de gestión para clubes de tenis y pádel. Reservas, torneos, academia y más." />
    <title>Courtside — Gestión de clubes de tenis y pádel</title>
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --green: #166534;
        --green-light: #16a34a;
        --green-subtle: #f0fdf4;
        --text: #111827;
        --text-muted: #6b7280;
        --border: #e5e7eb;
        --white: #ffffff;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        color: var(--text);
        line-height: 1.5;
      }

      /* NAV */
      nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 2rem;
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        background: var(--white);
        z-index: 10;
      }
      .logo { font-weight: 700; font-size: 1.25rem; color: var(--green); letter-spacing: -0.02em; }
      .nav-cta {
        background: var(--green);
        color: var(--white);
        padding: 0.5rem 1.25rem;
        border-radius: 0.375rem;
        text-decoration: none;
        font-size: 0.875rem;
        font-weight: 500;
      }
      .nav-cta:hover { background: var(--green-light); }

      /* HERO */
      .hero {
        text-align: center;
        padding: 5rem 2rem 4rem;
        max-width: 720px;
        margin: 0 auto;
      }
      .hero-badge {
        display: inline-block;
        background: var(--green-subtle);
        color: var(--green);
        font-size: 0.75rem;
        font-weight: 600;
        padding: 0.25rem 0.75rem;
        border-radius: 999px;
        margin-bottom: 1.5rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }
      .hero h1 {
        font-size: clamp(2rem, 5vw, 3.25rem);
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1.15;
        margin-bottom: 1.25rem;
        color: var(--text);
      }
      .hero h1 span { color: var(--green); }
      .hero p {
        font-size: 1.125rem;
        color: var(--text-muted);
        max-width: 540px;
        margin: 0 auto 2.5rem;
      }
      .hero-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
      .btn-primary {
        background: var(--green);
        color: var(--white);
        padding: 0.75rem 2rem;
        border-radius: 0.5rem;
        text-decoration: none;
        font-weight: 600;
        font-size: 1rem;
      }
      .btn-primary:hover { background: var(--green-light); }
      .btn-secondary {
        border: 1px solid var(--border);
        color: var(--text);
        padding: 0.75rem 2rem;
        border-radius: 0.5rem;
        text-decoration: none;
        font-weight: 500;
        font-size: 1rem;
      }
      .btn-secondary:hover { border-color: var(--green); color: var(--green); }

      /* FEATURES */
      .features {
        background: var(--green-subtle);
        padding: 5rem 2rem;
      }
      .features-inner { max-width: 1000px; margin: 0 auto; }
      .section-label {
        text-align: center;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--green);
        margin-bottom: 0.75rem;
      }
      .section-title {
        text-align: center;
        font-size: clamp(1.5rem, 3vw, 2.25rem);
        font-weight: 700;
        letter-spacing: -0.02em;
        margin-bottom: 3rem;
      }
      .features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1.5rem;
      }
      .feature-card {
        background: var(--white);
        border-radius: 0.75rem;
        padding: 1.5rem;
        border: 1px solid var(--border);
      }
      .feature-icon { font-size: 1.75rem; margin-bottom: 0.75rem; }
      .feature-card h3 { font-size: 1rem; font-weight: 600; margin-bottom: 0.4rem; }
      .feature-card p { font-size: 0.875rem; color: var(--text-muted); }

      /* TWO-APP SECTION */
      .apps-section { padding: 5rem 2rem; }
      .apps-inner {
        max-width: 900px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
      }
      @media (max-width: 600px) { .apps-inner { grid-template-columns: 1fr; } }
      .app-card {
        border: 1px solid var(--border);
        border-radius: 0.75rem;
        padding: 2rem;
      }
      .app-card.green { background: var(--green); color: var(--white); border-color: var(--green); }
      .app-card h3 { font-size: 1.25rem; font-weight: 700; margin-bottom: 0.5rem; }
      .app-card p { font-size: 0.9rem; opacity: 0.85; margin-bottom: 1.25rem; }
      .app-card ul { list-style: none; }
      .app-card ul li { font-size: 0.875rem; padding: 0.2rem 0; }
      .app-card ul li::before { content: "✓  "; font-weight: 700; }
      .app-card.green ul li::before { color: #86efac; }
      .app-card:not(.green) ul li::before { color: var(--green); }

      /* PRICING */
      .pricing { background: var(--green-subtle); padding: 5rem 2rem; }
      .pricing-inner { max-width: 420px; margin: 0 auto; text-align: center; }
      .price-card {
        background: var(--white);
        border: 2px solid var(--green);
        border-radius: 1rem;
        padding: 2.5rem 2rem;
        margin-top: 2rem;
      }
      .price-tag { font-size: 3rem; font-weight: 800; color: var(--green); letter-spacing: -0.04em; }
      .price-tag span { font-size: 1.25rem; font-weight: 500; color: var(--text-muted); }
      .price-desc { color: var(--text-muted); font-size: 0.875rem; margin: 0.5rem 0 1.5rem; }
      .price-features { list-style: none; text-align: left; margin-bottom: 2rem; }
      .price-features li { padding: 0.35rem 0; font-size: 0.875rem; }
      .price-features li::before { content: "✓  "; color: var(--green); font-weight: 700; }
      .btn-full {
        display: block;
        background: var(--green);
        color: var(--white);
        padding: 0.875rem;
        border-radius: 0.5rem;
        text-decoration: none;
        font-weight: 600;
        font-size: 1rem;
        text-align: center;
      }
      .btn-full:hover { background: var(--green-light); }

      /* FOOTER */
      footer {
        text-align: center;
        padding: 2rem;
        font-size: 0.8rem;
        color: var(--text-muted);
        border-top: 1px solid var(--border);
      }
    </style>
  </head>
  <body>

    <nav>
      <span class="logo">Courtside</span>
      <a href={adminAppUrl} class="nav-cta">Comenzar gratis →</a>
    </nav>

    <!-- HERO -->
    <section class="hero">
      <span class="hero-badge">Para clubes de tenis y pádel</span>
      <h1>Gestioná tu club<br /><span>sin complicaciones</span></h1>
      <p>
        Reservas online, gestión de socios, academia, torneos y más.
        Todo desde un panel web. Tus jugadores lo usan desde el celular.
      </p>
      <div class="hero-actions">
        <a href={adminAppUrl} class="btn-primary">Probalo gratis</a>
        <a href="#features" class="btn-secondary">Ver funciones</a>
      </div>
    </section>

    <!-- FEATURES -->
    <section class="features" id="features">
      <div class="features-inner">
        <p class="section-label">Funcionalidades</p>
        <h2 class="section-title">Todo lo que tu club necesita</h2>
        <div class="features-grid">
          <div class="feature-card">
            <div class="feature-icon">🎾</div>
            <h3>Reservas de canchas</h3>
            <p>Tus jugadores reservan desde el celular en segundos. Sin llamados, sin WhatsApps.</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">👥</div>
            <h3>Gestión de socios</h3>
            <p>Alta de jugadores por invitación, roles diferenciados, historial de pagos.</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">🏫</div>
            <h3>Academia</h3>
            <p>Grupos de entrenamiento, asistencia, clases privadas con tus profesores.</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">🏆</div>
            <h3>Torneos</h3>
            <p>Organización de torneos con brackets automáticos, resultados y seguimiento.</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">📊</div>
            <h3>Dashboard</h3>
            <p>Visión en tiempo real de ocupación de canchas, ingresos y actividad del club.</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">📲</div>
            <h3>App PWA para jugadores</h3>
            <p>Se instala en el celular sin pasar por el App Store. Lista en segundos.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- TWO-APP SECTION -->
    <section class="apps-section">
      <div class="features-inner" style="max-width:900px;margin:0 auto;">
        <p class="section-label" style="text-align:center;">Dos aplicaciones</p>
        <h2 class="section-title">Una para vos, una para tus jugadores</h2>
      </div>
      <div class="apps-inner">
        <div class="app-card green">
          <h3>Panel de administrador</h3>
          <p>Para el dueño y staff del club. Accedé desde cualquier computadora.</p>
          <ul>
            <li>Gestión completa de canchas</li>
            <li>Alta de socios e invitaciones</li>
            <li>Control de academia y torneos</li>
            <li>Dashboard de ingresos</li>
            <li>Configuración del club</li>
          </ul>
        </div>
        <div class="app-card">
          <h3>App para jugadores</h3>
          <p>Se descarga desde la invitación del club. Funciona offline.</p>
          <ul>
            <li>Reservar canchas al instante</li>
            <li>Ver sus turnos y pagos</li>
            <li>Inscribirse en torneos</li>
            <li>Seguir la academia</li>
            <li>Perfil personal</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- PRICING -->
    <section class="pricing" id="pricing">
      <div class="pricing-inner">
        <p class="section-label">Precio</p>
        <h2 class="section-title">Simple y predecible</h2>
        <div class="price-card">
          <div class="price-tag">USD 50<span>/mes</span></div>
          <p class="price-desc">Por club. Sin límite de usuarios ni canchas.</p>
          <ul class="price-features">
            <li>Reservas ilimitadas</li>
            <li>Socios ilimitados</li>
            <li>Academia y torneos incluidos</li>
            <li>App PWA para jugadores</li>
            <li>Soporte por WhatsApp</li>
          </ul>
          <a href={adminAppUrl} class="btn-full">Empezar ahora →</a>
        </div>
      </div>
    </section>

    <footer>
      <p>© {new Date().getFullYear()} Courtside. Hecho para clubes de raqueta.</p>
    </footer>

  </body>
</html>
